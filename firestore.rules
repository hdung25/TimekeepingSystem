rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function rolePath() { return /databases/$(database)/documents/user_roles/$(request.auth.uid); }
    function userRoleExists() { return isAuthenticated() && exists(rolePath()); }
    function roleData() { return get(rolePath()).data; }
    function getUserId() { return userRoleExists() ? roleData().get('userId', '') : ''; }
    function hasRole(roleName) {
      return userRoleExists() && (
        roleData().get('role', '') == roleName
        || roleData().get('roles', []).hasAny([roleName])
      );
    }
    function isAdmin() { return hasRole('admin') || hasRole('senior_assistant'); }
    function isPrimaryAdmin() { return hasRole('admin'); }
    function isSeniorAssistant() { return hasRole('senior_assistant'); }
    function isCoreAssistant() { return hasRole('assistant'); }
    function isScheduleManager() { return isAdmin() || isCoreAssistant(); }
    // Kept as a named policy boundary because office-role regression tests and
    // future office-only permissions must never collapse into reception scope.
    function isOfficeScheduleManager() { return isAdmin() || hasRole('assistant'); }
    function isReceptionScheduleManager() {
      return isScheduleManager() || hasRole('receptionist_assistant');
    }
    function isReceptionistOperator() {
      return hasRole('receptionist') || hasRole('receptionist_assistant')
        || hasRole('receptionist_lead') || hasRole('receptionist_staff')
        || hasRole('senior_assistant');
    }
    function canAuditAttendance() { return isScheduleManager() || isReceptionistOperator(); }
    function ownsStaffId(staffId) {
      let mappedUserId = getUserId();
      return isAuthenticated() && mappedUserId != '' && staffId == mappedUserId;
    }
    // A first check-in reads today's and yesterday's deterministic document IDs
    // inside a transaction before either document necessarily exists. In that
    // state resource.data is unavailable, so ownership must be proven from the
    // canonical document ID instead of from stored data.
    function isOwnAttendanceLogId(logId) {
      return isAuthenticated() && getUserId() != ''
        && getUserId() is string
        && getUserId().matches('[A-Za-z0-9_-]{1,80}')
        && logId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_' + getUserId());
    }
    function isSafeSeniorProfileUpdate() {
      return isSeniorAssistant()
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id', 'username', 'role', 'roles', 'authUid', 'password',
          // Payroll policy belongs to the primary Admin. These two fields
          // directly control hourly rates and +10 eligibility.
          'salary_config', 'teachingMode'
        ]) == false;
    }
    // A senior assistant may continue ordinary attendance maintenance, but a
    // primary-Admin payroll decision embedded in a session is immutable to that
    // role. List.removeAll turns a one-session edit into one removed + one added
    // map, so the nested override can be compared without assuming a fixed index.
    // Multi-session rewrites/reorders fail closed; the UI performs one session
    // mutation per save.
    function keepsAttendanceSessionOrderForSeniorEdit(before, after) {
      return before.size() == after.size()
        && before.size() <= 6
        && (before.size() < 1 || before[0].get('id', '') == after[0].get('id', ''))
        && (before.size() < 2 || before[1].get('id', '') == after[1].get('id', ''))
        && (before.size() < 3 || before[2].get('id', '') == after[2].get('id', ''))
        && (before.size() < 4 || before[3].get('id', '') == after[3].get('id', ''))
        && (before.size() < 5 || before[4].get('id', '') == after[4].get('id', ''))
        && (before.size() < 6 || before[5].get('id', '') == after[5].get('id', ''));
    }
    function preservesPayrollOverrideForSeniorUpdate(logId) {
      let beforeRaw = resource.data.get('sessions', []);
      let afterRaw = request.resource.data.get('sessions', []);
      let before = beforeRaw is list ? beforeRaw : [];
      let after = afterRaw is list ? afterRaw : [];
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      return isSeniorAssistant()
        && beforeRaw is list
        && afterRaw is list
        // The document identity is part of the protected payroll source.  A
        // senior assistant must not be able to make the same immutable session
        // disappear from, or move into, another employee/day query.
        && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        && request.resource.data.get('date', '') == resource.data.get('date', '')
        && logId == resource.data.get('date', '') + '_' + resource.data.get('userId', '')
        && request.resource.data.keys().hasAny(['lastAdminPayrollOverride'])
          == resource.data.keys().hasAny(['lastAdminPayrollOverride'])
        && request.resource.data.get('lastAdminPayrollOverride', null)
          == resource.data.get('lastAdminPayrollOverride', null)
        && (
          after == before
          || (
            after.size() == before.size() + 1
            && added.size() == 1
            && removed.size() == 0
            && added[0] is map
            && !added[0].keys().hasAny(['adminPayrollOverride'])
            && after.removeAll(added) == before
          )
          || (
            after.size() + 1 == before.size()
            && added.size() == 0
            && removed.size() == 1
            && removed[0] is map
            && !removed[0].keys().hasAny(['adminPayrollOverride'])
            && before.removeAll(removed) == after
          )
          || (
            after.size() == before.size()
            && added.size() == 1
            && removed.size() == 1
            && added[0] is map
            && removed[0] is map
            && added[0].get('id', '') == removed[0].get('id', '')
            && !added[0].keys().hasAny(['adminPayrollOverride'])
            && !removed[0].keys().hasAny(['adminPayrollOverride'])
            && after.removeAll(added) == before.removeAll(removed)
            && keepsAttendanceSessionOrderForSeniorEdit(before, after)
          )
        );
    }
    function isSafeSeniorAttendanceCreate(logId) {
      let sessions = request.resource.data.get('sessions', []);
      return isSeniorAssistant()
        && request.resource.data.get('userId', '') is string
        && request.resource.data.get('date', '') is string
        && request.resource.data.get('date', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && logId == request.resource.data.get('date', '') + '_'
          + request.resource.data.get('userId', '')
        && !request.resource.data.keys().hasAny(['lastAdminPayrollOverride'])
        && sessions is list
        && sessions.size() == 1
        && sessions[0] is map
        && !sessions[0].keys().hasAny(['adminPayrollOverride']);
    }
    function isSafeStaffDirectoryProfile(userId) {
      return request.resource.data.get('id', '') == userId
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'displayName', 'username', 'role', 'roles',
          'specialty', 'specialties', 'branch', 'branches', 'department',
          'position', 'title', 'isActive', 'active', 'status', 'scheduleColor'
        ]);
    }
    function matchesStaffProfileName(staffId, suppliedName) {
      return suppliedName is string
        && suppliedName.size() > 0
        && suppliedName.size() <= 120
        && exists(/databases/$(database)/documents/users/$(staffId))
        && (
          suppliedName == get(/databases/$(database)/documents/users/$(staffId)).data.get('name', '')
          || suppliedName == get(/databases/$(database)/documents/users/$(staffId)).data.get('username', '')
        );
    }
    function isOwnMonthlyDocument(docId) {
      return isAuthenticated() && getUserId() != ''
        && docId.matches('[0-9]{4}-[0-9]{2}_' + getUserId());
    }
    function statusMovesToReceived(oldStatus, newStatus) {
      return newStatus == oldStatus || (oldStatus == 'published' && newStatus == 'received');
    }
    function hasPayslipReceiptTransition() {
      return (
        resource.data.published.get('status', 'draft') == 'published'
        && request.resource.data.published.get('status', 'draft') == 'received'
      ) || (
        resource.data.published.get('status_gv', 'draft') == 'published'
        && request.resource.data.published.get('status_gv', 'draft') == 'received'
      ) || (
        resource.data.published.get('status_tt', 'draft') == 'published'
        && request.resource.data.published.get('status_tt', 'draft') == 'received'
      ) || (
        resource.data.published.get('status', 'draft') == 'published'
        && resource.data.published.get('status_gv', 'draft') == 'draft'
        && request.resource.data.published.get('status_gv', 'draft') == 'received'
      ) || (
        resource.data.published.get('status', 'draft') == 'published'
        && resource.data.published.get('status_tt', 'draft') == 'draft'
        && request.resource.data.published.get('status_tt', 'draft') == 'received'
      );
    }
    function isSafePayslipReceipt(docId) {
      return isOwnMonthlyDocument(docId)
        && resource.data.published is map
        && request.resource.data.published is map
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published'])
        && request.resource.data.published.diff(resource.data.published).affectedKeys().hasOnly([
          'status', 'status_gv', 'status_tt',
          'receivedAt', 'receivedAt_gv', 'receivedAt_tt',
          'confirmedBy', 'confirmedBy_gv', 'confirmedBy_tt'
        ])
        && (
          request.resource.data.published == resource.data.published
          || hasPayslipReceiptTransition()
        )
        && statusMovesToReceived(
          resource.data.published.get('status', 'draft'),
          request.resource.data.published.get('status', 'draft')
        )
        && (statusMovesToReceived(
          resource.data.published.get('status_gv', 'draft'),
          request.resource.data.published.get('status_gv', 'draft')
        ) || (resource.data.published.get('status', 'draft') == 'published'
          && resource.data.published.get('status_gv', 'draft') == 'draft'
          && request.resource.data.published.get('status_gv', 'draft') == 'received'))
        && (statusMovesToReceived(
          resource.data.published.get('status_tt', 'draft'),
          request.resource.data.published.get('status_tt', 'draft')
        ) || (resource.data.published.get('status', 'draft') == 'published'
          && resource.data.published.get('status_tt', 'draft') == 'draft'
          && request.resource.data.published.get('status_tt', 'draft') == 'received'));
    }
    function isOwnPendingRequest() {
      return ownsStaffId(request.resource.data.get('staffId', ''))
        && request.resource.data.get('status', '') == 'pending';
    }
    function isCanonicalBonus10RequestId(requestId) {
      return request.resource.data.get('staffId', '') is string
        && request.resource.data.get('staffId', '').matches('[A-Za-z0-9_-]{1,80}')
        && request.resource.data.get('dateKey', '') is string
        && request.resource.data.get('dateKey', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.get('sessionId', '') is string
        && request.resource.data.get('sessionId', '').matches('[A-Za-z0-9_-]{1,160}')
        && request.resource.data.get('targetShiftKey', '') is string
        && request.resource.data.get('targetShiftKey', '').matches('[A-Za-z0-9_:-]{1,240}')
        && requestId == 'b10~'
          + request.resource.data.get('dateKey', '') + '~'
          + request.resource.data.get('staffId', '') + '~'
          + request.resource.data.get('targetShiftKey', '');
    }
    function hasBonus10RegistrationAssignment(data) {
      let registration = get(/databases/$(database)/documents/schedule_registrations/$(data.scheduleRegistrationId)).data;
      return data.scheduleRegistrationId.matches('[A-Za-z0-9_-]{1,180}')
        && registration.status == 'active'
        && registration.userId == data.staffId
        && registration.scheduleDocId == data.scheduleDocId
        && registration.section == data.scheduleSection
        && registration.rowIndex == data.scheduleIndex
        && (data.scheduleShiftId == '' || registration.shiftId == data.scheduleShiftId);
    }
    function bonus10ClockMinutes(value) {
      return int(value[0:2]) * 60 + int(value[3:5]);
    }
    function bonus10CheckInLocalMinutes(proofTime) {
      return (proofTime.hours() * 60 + proofTime.minutes() + 420) % 1440;
    }
    function bonus10VerifiedEarlyMinutes(data, proofTime) {
      let raw = bonus10ClockMinutes(data.classStart) - bonus10CheckInLocalMinutes(proofTime);
      let normalized = raw > 720 ? raw - 1440 : (raw < -720 ? raw + 1440 : raw);
      // Never round seconds up: 07:50:00.001 for an 08:00 class is only
      // nine complete minutes early.
      return normalized - (proofTime.seconds() == 0 && proofTime.nanos() == 0 ? 0 : 1);
    }
    function isBonus10ProofOnDate(data, proofTime) {
      let localTime = proofTime + duration.value(7, 'h');
      return localTime.year() == int(data.dateKey[0:4])
        && localTime.month() == int(data.dateKey[5:7])
        && localTime.day() == int(data.dateKey[8:10]);
    }
    function isValidStaffAutoApprovedBonus10() {
      let data = request.resource.data;
      let schedule = get(/databases/$(database)/documents/schedules/$(data.scheduleDocId)).data;
      let row = schedule[data.scheduleSection][data.scheduleIndex];
      let attendance = get(/databases/$(database)/documents/attendance_logs/$(data.dateKey + '_' + data.staffId)).data;
      let session = attendance.sessions[data.attendanceSessionIndex];
      let profile = get(/databases/$(database)/documents/users/$(data.staffId)).data;
      let subject = get(/databases/$(database)/documents/subjects/$(data.subjectId)).data;
      let proof = get(/databases/$(database)/documents/attendance_checkin_proofs/$(
        data.dateKey + '~' + data.staffId + '~' + data.sessionId
      )).data;
      let listName = data.scheduleAssignmentList;
      let assignment = data.scheduleAssignmentEntry;
      return ownsStaffId(data.staffId)
        && data.keys().hasOnly([
          'staffId', 'staffName', 'dateKey', 'sessionId', 'status', 'awardScope',
          'targetShiftKey', 'subjectId', 'scheduleDocId', 'scheduleSection',
          'scheduleIndex', 'scheduleShiftId', 'scheduleRegistrationId',
          'scheduleAssignmentList', 'scheduleAssignmentEntry', 'classStart',
          'classEnd', 'attendanceSessionIndex', 'earlyMinutes', 'checkInAt',
          'scheduledStart', 'requestSource', 'authUid', 'schemaVersion',
          'policyVersion', 'createdAt', 'approvedBy', 'approvedByName', 'approvedAt'
        ])
        && data.status == 'approved'
        && data.awardScope == 'teaching_shift'
        && data.requestSource == 'staff_auto_approved'
        && data.authUid == request.auth.uid
        && data.approvedBy == data.staffId
        && data.schemaVersion == 2
        && data.policyVersion == 'early10-shift-v2'
        && data.createdAt == request.time
        && data.approvedAt == request.time
        && data.earlyMinutes is int
        && data.earlyMinutes >= 10
        && data.earlyMinutes <= 720
        && proof.get('staffId', '') == data.staffId
        && proof.get('dateKey', '') == data.dateKey
        && proof.get('sessionId', '') == data.sessionId
        && proof.get('authUid', '') == request.auth.uid
        && proof.get('recordedAt', null) is timestamp
        && isBonus10ProofOnDate(data, proof.recordedAt)
        && data.earlyMinutes == bonus10VerifiedEarlyMinutes(data, proof.recordedAt)
        && data.checkInAt is string
        && data.checkInAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z')
        && data.classStart.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && data.classEnd.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && data.scheduledStart == data.classStart
        && data.scheduleSection in [
          'morning1', 'morning2', 'afternoon1', 'afternoon2', 'evening1', 'evening2'
        ]
        && data.scheduleIndex is int
        && data.scheduleIndex >= 0
        && data.attendanceSessionIndex is int
        && data.attendanceSessionIndex >= 0
        && data.scheduleDocId is string
        && (
          data.scheduleDocId == data.dateKey
          || data.scheduleDocId.matches('[A-Za-z0-9_-]{1,80}__' + data.dateKey)
        )
        && data.subjectId.matches('[A-Za-z0-9_-]{1,160}')
        && data.scheduleShiftId is string
        && data.scheduleShiftId.size() <= 160
        && data.scheduleRegistrationId is string
        && data.scheduleRegistrationId.size() <= 180
        && listName is string
        && assignment is map
        && (data.staffName == profile.get('name', '') || data.staffName == profile.get('username', ''))
        && (data.approvedByName == profile.get('name', '') || data.approvedByName == profile.get('username', ''))
        && profile.get('teachingMode', 'unset') != 'new'
        && subject.get('allowEarly10', false) == true
        && session.get('checkIn', session.get('start', '')) == data.checkInAt
        && (
          !(session.get('id', '') is string)
          || session.get('id', '') == data.sessionId
        )
        && row.get('start', '') == data.classStart
        && row.get('end', '') == data.classEnd
        && row.get('lopId', '') is string
        && row.get('lopId', '').matches('(^|.*[+])' + data.subjectId + '([+].*|$)')
        && (
          (
            row.get('shiftId', '').matches('[A-Za-z0-9_-]{1,160}')
            && data.scheduleShiftId == row.get('shiftId', '')
            && data.targetShiftKey == 'teaching__' + data.dateKey + '__shift__' + row.get('shiftId', '')
          ) || (
            row.get('shiftId', '') == ''
            && data.scheduleShiftId == ''
            && data.targetShiftKey == 'teaching__' + data.dateKey + '__'
              + data.scheduleDocId + '__' + data.scheduleSection + '__'
              + data.classStart + '-' + data.classEnd
          )
        )
        && (
          row.get('gvId', '') == data.staffId
          || row.get('gvThayTeId', '') == data.staffId
          || row.get('gvThayTheId', '') == data.staffId
          || (
            listName in ['gvList', 'gvThayTeList', 'gvThayTheList', 'registeredTeachers']
            && assignment.get('id', '') == data.staffId
            && row.get(listName, []) is list
            && row.get(listName, []).hasAny([assignment])
          )
          || (data.scheduleRegistrationId != '' && hasBonus10RegistrationAssignment(data))
        );
    }
    function isOwnScheduleRegistration() {
      return ownsStaffId(request.resource.data.get('userId', ''))
        && request.resource.data.get('authUid', '') == request.auth.uid
        && request.resource.data.get('scheduleKey', '') is string
        && request.resource.data.get('scheduleKey', '').size() > 0
        && request.resource.data.get('scheduleKey', '').size() <= 120
        && request.resource.data.get('scheduleDocId', '') is string
        && request.resource.data.get('scheduleDocId', '').size() > 0
        && request.resource.data.get('scheduleDocId', '').size() <= 120
        && request.resource.data.get('branch', '') is string
        && request.resource.data.get('branch', '').size() > 0
        && request.resource.data.get('branch', '').size() <= 20
        && request.resource.data.get('dateKey', '') is string
        && request.resource.data.get('dateKey', '').size() == 10
        && request.resource.data.get('section', '') is string
        && request.resource.data.get('section', '') in [
          'morning1', 'morning2', 'afternoon1', 'afternoon2', 'evening1', 'evening2'
        ]
        && request.resource.data.get('rowIndex', -1) is int
        && request.resource.data.get('rowIndex', -1) >= 0
        && request.resource.data.get('shiftId', '') is string
        && request.resource.data.get('shiftId', '').size() <= 120
        && request.resource.data.get('rowSignature', '') is string
        && request.resource.data.get('rowSignature', '').size() > 0
        && request.resource.data.get('rowSignature', '').size() <= 300
        && matchesStaffProfileName(
          request.resource.data.get('userId', ''),
          request.resource.data.get('userName', '')
        )
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('status', '') in ['active', 'cancelled']
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.keys().hasOnly([
          'scheduleKey', 'scheduleDocId', 'branch', 'dateKey', 'section',
          'rowIndex', 'shiftId', 'rowSignature', 'userId', 'authUid',
          'schemaVersion', 'createdAt', 'userName', 'status', 'updatedAt'
        ]);
    }
    function keepsScheduleRegistrationTarget() {
      return request.resource.data.get('userId', '') == resource.data.get('userId', '')
        && request.resource.data.get('scheduleKey', '') == resource.data.get('scheduleKey', '')
        && request.resource.data.get('scheduleDocId', '') == resource.data.get('scheduleDocId', '')
        && request.resource.data.get('branch', '') == resource.data.get('branch', '')
        && request.resource.data.get('dateKey', '') == resource.data.get('dateKey', '')
        && request.resource.data.get('section', '') == resource.data.get('section', '')
        && request.resource.data.get('rowIndex', -1) == resource.data.get('rowIndex', -1)
        && request.resource.data.get('shiftId', '') == resource.data.get('shiftId', '')
        && request.resource.data.get('rowSignature', '') == resource.data.get('rowSignature', '')
        && request.resource.data.get('authUid', '') == resource.data.get('authUid', '')
        && request.resource.data.get('schemaVersion', 0) == resource.data.get('schemaVersion', 0)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }
    function isSafeNewAttendanceSession(session, dateKey) {
      return session is map
        && session.keys().hasOnly([
          'id', 'anchorDateKey', 'status', 'source', 'start', 'checkIn', 'checkOut'
        ])
        && session.get('id', '') is string
        && session.get('id', '').size() > 0
        && session.get('id', '').size() <= 120
        && session.get('anchorDateKey', '') == dateKey
        && session.get('status', '') == 'open'
        && session.get('source', '') == 'self'
        && session.get('start', '') is string
        && session.get('start', '').size() >= 20
        && session.get('start', '').size() <= 40
        && session.get('checkIn', '') == session.get('start', '')
        && session.get('checkOut', 'not-null') == null;
    }
    function keepsAttendanceSessionFinancialFields(oldSession, newSession, dateKey) {
      return oldSession is map
        && newSession is map
        && newSession.get('id', '') == oldSession.get('id', '')
        && newSession.get('start', '') == oldSession.get('start', '')
        && newSession.get('checkIn', '') == oldSession.get('checkIn', '')
        && newSession.get('source', '') == oldSession.get('source', '')
        && newSession.get('anchorDateKey', dateKey) == dateKey
        && newSession.get('checkOut', '') is string
        && newSession.get('checkOut', '').size() >= 20
        && newSession.get('checkOut', '').size() <= 40
        && newSession.get('status', 'open') in ['open', 'closed']
        && newSession.diff(oldSession).affectedKeys().hasOnly([
          'checkOut', 'status', 'anchorDateKey', 'autoClosedReason'
        ]);
    }
    function isSafeStudentCountSessionTransition(oldSession, newSession, dateKey) {
      let oldStatus = oldSession.get('studentCountStatus', '');
      let hasCount = newSession.keys().hasAll([
        'studentCount', 'studentCountStatus', 'studentCountUpdatedAt', 'studentCountUpdatedBy'
      ]);
      let clearsCount = !newSession.keys().hasAny([
        'studentCount', 'studentCountStatus', 'studentCountUpdatedAt', 'studentCountUpdatedBy'
      ]);
      return oldSession is map
        && newSession is map
        && oldStatus in ['', 'pending']
        && newSession.get('id', '') == oldSession.get('id', '')
        && newSession.get('start', '') == oldSession.get('start', '')
        && newSession.get('checkIn', '') == oldSession.get('checkIn', '')
        && newSession.get('checkOut', null) == oldSession.get('checkOut', null)
        && newSession.get('source', '') == oldSession.get('source', '')
        && newSession.get('anchorDateKey', dateKey) == oldSession.get('anchorDateKey', dateKey)
        && newSession.get('status', '') == oldSession.get('status', '')
        && newSession.diff(oldSession).affectedKeys().hasOnly([
          'studentCount', 'studentCountStatus', 'studentCountUpdatedAt', 'studentCountUpdatedBy'
        ])
        && (clearsCount || (
          hasCount
          && newSession.get('studentCount', 0) is int
          && newSession.get('studentCount', 0) >= 1
          && newSession.get('studentCount', 0) <= 500
          && newSession.get('studentCountStatus', '') == 'pending'
          && newSession.get('studentCountUpdatedBy', '') == resource.data.get('userId', '')
          && newSession.get('studentCountUpdatedAt', '') is string
          && newSession.get('studentCountUpdatedAt', '').size() >= 20
          && newSession.get('studentCountUpdatedAt', '').size() <= 40
        ));
    }
    function isSafeAttendanceStudentCountTransition() {
      let oldSessions = resource.data.get('sessions', []);
      let newSessions = request.resource.data.get('sessions', []);
      let addedSessions = newSessions is list && oldSessions is list
        ? newSessions.removeAll(oldSessions) : [];
      let removedSessions = newSessions is list && oldSessions is list
        ? oldSessions.removeAll(newSessions) : [];
      return oldSessions is list
        && newSessions is list
        && newSessions.size() == oldSessions.size()
        && addedSessions.size() == 1
        && removedSessions.size() == 1
        && isSafeStudentCountSessionTransition(
          removedSessions[0], addedSessions[0], resource.data.get('date', '')
        );
    }
    function isSafeAttendanceSessionsTransition() {
      let oldSessions = resource.data.get('sessions', []);
      let newSessions = request.resource.data.get('sessions', []);
      let addedSessions = newSessions is list && oldSessions is list
        ? newSessions.removeAll(oldSessions) : [];
      let removedSessions = newSessions is list && oldSessions is list
        ? oldSessions.removeAll(newSessions) : [];
      return oldSessions is list
        && newSessions is list
        && newSessions.size() <= 24
        && (
          newSessions == oldSessions
          || (
            newSessions.size() == oldSessions.size() + 1
            && addedSessions.size() == 1
            && removedSessions.size() == 0
            && addedSessions[0] == newSessions[newSessions.size() - 1]
            && (
              isSafeNewAttendanceSession(
                addedSessions[0], request.resource.data.get('date', '')
              )
            )
            && request.resource.data.get('checkIn', '') == addedSessions[0].get('checkIn', '')
            && request.resource.data.get('checkOut', 'not-null') == null
          )
          || (
            newSessions.size() == oldSessions.size()
            && addedSessions.size() == 1
            && removedSessions.size() == 1
            && keepsAttendanceSessionFinancialFields(
              removedSessions[0], addedSessions[0], request.resource.data.get('date', '')
            )
          )
        );
    }
    function isSafeLegacyAttendanceMigration() {
      let newSessions = request.resource.data.get('sessions', []);
      let legacyCheckIn = resource.data.get('checkIn', '');
      return !(resource.data.get('sessions', null) is list)
        && legacyCheckIn is string
        && legacyCheckIn.size() >= 20
        && newSessions is list
        && newSessions.size() >= 1
        && newSessions.size() <= 2
        && newSessions[0] is map
        && newSessions[0].get('start', '') == legacyCheckIn
        && newSessions[0].get('checkIn', '') == legacyCheckIn
        && (
          (
            newSessions.size() == 2
            && newSessions[0].keys().hasOnly(['start', 'checkIn', 'checkOut'])
            && newSessions[0].get('checkOut', null) == resource.data.get('checkOut', null)
            && isSafeNewAttendanceSession(
              newSessions[1], request.resource.data.get('date', '')
            )
          )
          || (
            newSessions.size() == 1
            && newSessions[0].keys().hasOnly([
              'id', 'start', 'checkIn', 'checkOut', 'status', 'anchorDateKey'
            ])
            && newSessions[0].get('id', '') == 'legacy'
            && newSessions[0].get('checkOut', '') is string
            && newSessions[0].get('checkOut', '').size() >= 20
            && newSessions[0].get('status', '') == 'closed'
            && newSessions[0].get('anchorDateKey', '') == request.resource.data.get('date', '')
          )
        );
    }

    // UID-keyed security map: users may read only their own mapping and cannot
    // write themselves into a privileged role. `senior_assistant` is a broad
    // operational manager elsewhere, but it must never be able to mint the
    // literal `admin` role (including by rewriting its own UID mapping).
    match /user_roles/{authUid} {
      allow get: if isAuthenticated() && (request.auth.uid == authUid || isAdmin());
      allow list: if isAuthenticated() && isAdmin();
      allow create, update, delete: if isAuthenticated() && isPrimaryAdmin();
    }

    // Full profiles contain private payroll configuration. Staff can read only
    // their own profile; shared roster screens use staff_directory below.
    match /users/{userId} {
      allow get: if isAuthenticated() && (isAdmin() || ownsStaffId(userId));
      allow list: if isAuthenticated() && isAdmin();
      allow create, delete: if isAuthenticated() && isPrimaryAdmin();
      allow update: if isAuthenticated() && (
        isPrimaryAdmin() || isSafeSeniorProfileUpdate()
      );
    }

    match /staff_directory/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isPrimaryAdmin()
        && isSafeStaffDirectoryProfile(userId);
      allow update: if isAuthenticated()
        && (isPrimaryAdmin() || isSafeSeniorProfileUpdate())
        && isSafeStaffDirectoryProfile(userId);
      allow delete: if isAuthenticated() && isPrimaryAdmin();
    }

    // Managers administer compatibility credentials. An employee can rotate
    // only their own password and cannot read or list credential documents.
    match /user_credentials/{staffId} {
      allow read: if isAuthenticated() && isPrimaryAdmin();
      allow create: if isAuthenticated() && (isPrimaryAdmin() || (
        ownsStaffId(staffId)
        && request.resource.data.get('staffId', '') == staffId
        && request.resource.data.get('password', '') is string
        && request.resource.data.get('password', '').size() >= 6
        && request.resource.data.get('password', '').size() <= 256
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.keys().hasOnly(['staffId', 'password', 'updatedAt'])
      ));
      allow update: if isAuthenticated() && (isPrimaryAdmin() || (
        ownsStaffId(staffId)
        && resource.data.get('staffId', '') == staffId
        && request.resource.data.get('staffId', '') == staffId
        && request.resource.data.get('password', '') is string
        && request.resource.data.get('password', '').size() >= 6
        && request.resource.data.get('password', '').size() <= 256
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'updatedAt'])
      ));
      allow delete: if isAuthenticated() && isPrimaryAdmin();
    }

    // Employees can mutate only their mapped attendance document. Cross-staff
    // edits and deletion are management operations.
    match /attendance_logs/{logId} {
      allow get: if isAuthenticated()
        && ((isOwnAttendanceLogId(logId)
            && !exists(/databases/$(database)/documents/attendance_logs/$(logId)))
          || isAdmin() || canAuditAttendance()
          || ownsStaffId(resource.data.get('userId', '')));
      allow list: if isAuthenticated()
        && (isAdmin() || canAuditAttendance()
          || ownsStaffId(resource.data.get('userId', '')));
      allow create: if isAuthenticated() && ((
        ownsStaffId(request.resource.data.get('userId', ''))
        && request.resource.data.get('date', '') is string
        && request.resource.data.get('date', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && logId == request.resource.data.get('date', '') + '_'
          + request.resource.data.get('userId', '')
        && matchesStaffProfileName(
          request.resource.data.get('userId', ''),
          request.resource.data.get('name', '')
        )
        && request.resource.data.keys().hasOnly([
          'userId', 'name', 'date', 'sessions', 'checkIn', 'checkOut', 'lastUpdated'
        ])
        && request.resource.data.get('sessions', []) is list
        && request.resource.data.get('sessions', []).size() == 1
        && (
          isSafeNewAttendanceSession(
            request.resource.data.get('sessions', [])[0],
            request.resource.data.get('date', '')
          )
        )
        && request.resource.data.get('checkIn', '')
          == request.resource.data.get('sessions', [])[0].get('checkIn', '')
        && request.resource.data.get('checkOut', 'not-null') == null
        && request.resource.data.get('lastUpdated', null) == request.time
      ) || isPrimaryAdmin() || isSafeSeniorAttendanceCreate(logId));
      allow update: if isAuthenticated() && ((
        ownsStaffId(resource.data.get('userId', ''))
        && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        && request.resource.data.get('date', '') == resource.data.get('date', '')
        && logId == resource.data.get('date', '') + '_' + resource.data.get('userId', '')
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
          || matchesStaffProfileName(
            request.resource.data.get('userId', ''),
            request.resource.data.get('name', '')
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sessions', 'checkIn', 'checkOut', 'lastUpdated', 'name'
        ])
        && (
          (
            request.resource.data.get('sessions', []) == resource.data.get('sessions', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastUpdated'])
          )
          || (
            request.resource.data.get('lastUpdated', null) == request.time
            && (
              isSafeAttendanceSessionsTransition()
              || isSafeLegacyAttendanceMigration()
              || isSafeAttendanceStudentCountTransition()
            )
          )
        )
      ) || isPrimaryAdmin() || preservesPayrollOverrideForSeniorUpdate(logId));
      allow delete: if isAuthenticated() && isPrimaryAdmin();
    }

    match /attendance_location_events/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.staffId is string
        && request.resource.data.staffId == getUserId()
        && ownsStaffId(request.resource.data.staffId)
        && request.resource.data.staffId.size() <= 80
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 64
        && request.resource.data.stage == 'location_gate'
        && request.resource.data.permissionState in ['granted', 'prompt', 'denied', 'unsupported', 'unknown']
        && request.resource.data.browserContext in ['browser', 'standalone', 'zalo', 'social_webview', 'android_webview']
        && request.resource.data.platform in ['android', 'ios', 'desktop']
        && request.resource.data.secureContext is bool
        && request.resource.data.online is bool
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'authUid', 'staffId', 'dateKey', 'code', 'stage', 'permissionState',
          'browserContext', 'platform', 'secureContext', 'online', 'appVersion', 'createdAt'
        ]);
      allow read, delete: if isAuthenticated() && isAdmin();
      allow update: if false;
    }

    // Immutable server-time receipt for a self check-in. Payroll rules use this
    // receipt instead of trusting the client-authored ISO display timestamp.
    match /attendance_checkin_proofs/{proofId} {
      allow read: if isAuthenticated()
        && (isAdmin() || ownsStaffId(resource.data.get('staffId', '')));
      allow create: if isAuthenticated()
        && ownsStaffId(request.resource.data.get('staffId', ''))
        && request.resource.data.get('authUid', '') == request.auth.uid
        && request.resource.data.get('dateKey', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.get('sessionId', '').matches('[A-Za-z0-9_-]{1,120}')
        && proofId == request.resource.data.get('dateKey', '') + '~'
          + request.resource.data.get('staffId', '') + '~'
          + request.resource.data.get('sessionId', '')
        && request.resource.data.get('recordedAt', null) == request.time
        && request.resource.data.keys().hasOnly([
          'staffId', 'dateKey', 'sessionId', 'authUid', 'recordedAt', 'schemaVersion'
        ])
        && request.resource.data.get('schemaVersion', 0) == 1;
      allow update, delete: if isAuthenticated() && isPrimaryAdmin();
    }

    // Immutable audit marker for the scheduler's attendance-correction panel.
    // Detailed before/after data remains on the corrected session; this compact
    // record proves which authenticated primary admin committed the operation.
    match /schedule_attendance_admin_audits/{auditId} {
      allow read: if isAuthenticated() && isPrimaryAdmin();
      allow create: if isAuthenticated()
        && isPrimaryAdmin()
        && request.resource.data.keys().hasAll([
          'authUid', 'actorUserId', 'staffId', 'dateKey',
          'sessionId', 'action', 'source', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'authUid', 'actorUserId', 'staffId', 'dateKey',
          'sessionId', 'action', 'source', 'createdAt'
        ])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.actorUserId == getUserId()
        && request.resource.data.actorUserId is string
        && request.resource.data.actorUserId.size() > 0
        && request.resource.data.actorUserId.size() <= 80
        && request.resource.data.staffId is string
        && request.resource.data.staffId.size() > 0
        && request.resource.data.staffId.size() <= 80
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.sessionId.size() <= 160
        && request.resource.data.action == 'save_correction'
        && request.resource.data.source == 'schedule_attendance_popup'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Immutable companion write for absolute payroll-chip allocations made in
    // Bảng Công.  Including this document in the same transaction turns the
    // literal primary-admin role into a server-enforced boundary even though
    // senior assistants retain older attendance maintenance permissions.
    match /admin_payroll_override_audits/{auditId} {
      allow read: if isAuthenticated() && isPrimaryAdmin();
      allow create: if isAuthenticated()
        && isPrimaryAdmin()
        && request.resource.data.keys().hasAll([
          'authUid', 'actorUserId', 'staffId', 'dateKey', 'sessionId',
          'action', 'mode', 'revision', 'reason', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'authUid', 'actorUserId', 'staffId', 'dateKey', 'sessionId',
          'action', 'mode', 'revision', 'reason', 'createdAt'
        ])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.actorUserId == getUserId()
        && request.resource.data.staffId is string
        && request.resource.data.staffId.matches('[A-Za-z0-9_-]{1,80}')
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.matches('[A-Za-z0-9_-]{1,160}')
        && request.resource.data.action == 'save_payroll_override'
        && request.resource.data.mode in ['schedule', 'actual', 'manual']
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Nested schedule arrays cannot safely authorize a field-only self-edit.
    // Mutations therefore match the actual editor roles in the scheduler UI.
    match /schedules/{dateId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isScheduleManager();
    }

    // Self-service “Nhận lớp / Hủy nhận” is stored separately from the
    // manager-owned schedule document. Owners can only activate/cancel their
    // own immutable shift target; cancellation is an auditable tombstone.
    match /schedule_registrations/{registrationId} {
      // First registration reads its deterministic ID before creating it.
      // Only a missing own-ID path is readable without resource.data; existing
      // documents and queries must still prove the stored owner.
      allow get: if isAuthenticated() && (
        (getUserId().matches('[A-Za-z0-9_-]{1,60}')
          && registrationId.matches('reg_[a-z0-9]{1,7}_[a-z0-9]{1,7}_' + getUserId())
          && !exists(/databases/$(database)/documents/schedule_registrations/$(registrationId)))
        || isScheduleManager() || ownsStaffId(resource.data.get('userId', ''))
      );
      allow list: if isAuthenticated()
        && (isScheduleManager() || ownsStaffId(resource.data.get('userId', '')));
      allow create: if isAuthenticated()
        && (isScheduleManager() || isOwnScheduleRegistration());
      allow update: if isAuthenticated() && (isScheduleManager() || (
        ownsStaffId(resource.data.get('userId', ''))
        && resource.data.get('authUid', '') == request.auth.uid
        && request.resource.data.get('authUid', '') == request.auth.uid
        && keepsScheduleRegistrationTarget()
        && matchesStaffProfileName(
          request.resource.data.get('userId', ''),
          request.resource.data.get('userName', '')
        )
        && request.resource.data.get('status', '') in ['active', 'cancelled']
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'userName', 'updatedAt'
        ])
      ));
      allow delete: if isAuthenticated() && isScheduleManager();
    }

    // Core assistants retain the existing settings-page workflow. A reception
    // assistant may update only reception shift hours in the system document.
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() || (isCoreAssistant() && docId.matches('schedule_manifest.*'))
      );
      allow delete: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && (isScheduleManager() || (
        hasRole('receptionist_assistant') && docId == 'system'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receptionistShifts',
          'receptionistShifts_cs1', 'receptionistShifts_cs2', 'receptionistShifts_cs3'
        ])
      ));
    }

    match /unregistered_alerts/{alertId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create, update: if isAuthenticated() && (isAdmin() || (
        ownsStaffId(request.resource.data.get('userId', ''))
        && alertId == request.resource.data.get('date', '') + '_' + getUserId()
        && request.resource.data.get('resolved', false) == false
      ));
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Recipients may only mark their own notification read.
    match /admin_notifications/{notificationId} {
      allow read: if isAuthenticated()
        && (isAdmin() || ownsStaffId(resource.data.get('staffId', '')));
      allow create, delete: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && (isAdmin() || (
        ownsStaffId(resource.data.get('staffId', ''))
        && request.resource.data.get('staffId', '') == resource.data.get('staffId', '')
        && request.resource.data.get('read', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
      ));
    }

    // Reception and office rosters intentionally remain separate.
    match /receptionist_schedules/{weekId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isReceptionScheduleManager();
    }
    match /office_schedules/{weekId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOfficeScheduleManager();
    }

    match /receptionist_shift_presence/{presenceId} {
      allow read: if isAuthenticated() && (isScheduleManager() || isReceptionistOperator());
      allow create, update: if isAuthenticated()
        && isReceptionistOperator()
        && ownsStaffId(request.resource.data.get('staffId', ''))
        && request.resource.data.get('authUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'active'
        && presenceId == request.resource.data.get('dateKey', '') + '_'
          + request.resource.data.get('branch', '') + '_'
          + request.resource.data.get('shiftKey', '') + '_'
          + request.resource.data.get('staffId', '');
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /shift_observations/{observationId} {
      allow read: if isAuthenticated() && (isScheduleManager() || isReceptionistOperator()
        || resource.data.get('teacherId', '') == getUserId());
      allow create: if isAuthenticated()
        && (isScheduleManager() || isReceptionistOperator())
        && request.resource.data.get('createdByAuthUid', '') == request.auth.uid
        && request.resource.data.get('createdByStaffId', '') == getUserId()
        && request.resource.data.get('status', '') == 'active'
        && request.resource.data.get('lateMinutes', -1) is int
        && request.resource.data.get('lateMinutes', -1) >= 0
        && request.resource.data.get('lateMinutes', -1) <= 240
        && (isScheduleManager() || exists(/databases/$(database)/documents/receptionist_shift_presence/$(
          request.resource.data.get('dateKey', '') + '_'
          + request.resource.data.get('branch', '') + '_'
          + request.resource.data.get('shiftKey', '') + '_'
          + request.resource.data.get('createdByStaffId', '')
        )));
      allow update: if isAuthenticated() && isAdmin()
        && request.resource.data.get('status', '') == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledByName', 'cancelReason', 'cancelledAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /daily_notes/{staffId} {
      allow read, create, update, delete: if isAuthenticated()
        && (ownsStaffId(staffId) || isScheduleManager());
    }

    // Salary data is private. Employees see only their own records and can
    // transition published -> received without changing any monetary payload.
    match /salary_settings/{staffId} {
      allow read: if isAuthenticated() && (ownsStaffId(staffId) || isAdmin());
      allow create, update, delete: if isAuthenticated() && isPrimaryAdmin();
    }
    match /salary_settings_monthly/{docId} {
      allow read: if isAuthenticated() && (isOwnMonthlyDocument(docId) || isAdmin());
      allow create, delete: if isAuthenticated() && isPrimaryAdmin();
      allow update: if isAuthenticated() && (isPrimaryAdmin() || isSafePayslipReceipt(docId));
    }
    match /staff_payroll_profiles/{staffId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create, update, delete: if isAuthenticated() && isPrimaryAdmin();
    }

    // Overtime requests still begin pending. A +10 request is different: its
    // immutable teaching-shift evidence is verified here, so an eligible staff
    // request may be created directly as approved without waiting for Admin.
    match /overtime_requests/{requestId} {
      allow read: if isAuthenticated() && (isAdmin() || ownsStaffId(resource.data.get('staffId', '')));
      allow create: if isAuthenticated() && (isAdmin() || isOwnPendingRequest());
      allow update, delete: if isAuthenticated() && isAdmin();
    }
    match /bonus10_requests/{requestId} {
      allow read: if isAuthenticated() && (isAdmin() || ownsStaffId(resource.data.get('staffId', '')));
      // New documents are singleton/canonical. Existing random-ID legacy docs
      // remain readable and Admin-updatable, but stale clients cannot create a
      // second active request beside the canonical transaction document.
      allow create: if isAuthenticated()
        && isCanonicalBonus10RequestId(requestId)
        // Put the common staff path first. Besides making the intent explicit,
        // short-circuiting avoids spending the Firestore 1,000-expression budget
        // on two manager-role lookups before validating a legitimate claim.
        && (isValidStaffAutoApprovedBonus10() || isAdmin());
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // Operational flags remain readable for chip calculations.
    match /fixed_shifts/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isReceptionScheduleManager();
    }
    match /cancelled_shifts/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isReceptionScheduleManager();
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    match /meetings_log/{docId} {
      allow read, create, update, delete: if isAuthenticated() && isAdmin();
    }
    match /meetings/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }
    match /meeting_attendance/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || ownsStaffId(resource.data.get('userId', '')));
      allow create: if isAuthenticated() && (isAdmin() || (
        ownsStaffId(request.resource.data.get('userId', ''))
        && docId == request.resource.data.get('meetingId', '') + '_' + getUserId()
      ));
      allow update: if isAuthenticated() && (isAdmin() || (
        ownsStaffId(resource.data.get('userId', ''))
        && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        && request.resource.data.get('meetingId', '') == resource.data.get('meetingId', '')
        && docId == resource.data.get('meetingId', '') + '_' + getUserId()
      ));
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /makeup_requests/{requestId} {
      allow read: if isAuthenticated() && (isAdmin() || ownsStaffId(resource.data.get('staffId', '')));
      allow create: if isAuthenticated() && (isAdmin() || isOwnPendingRequest());
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
