rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- RBAC HELPERS ---
    function userDocExists() {
      return exists(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function getUserDoc() {
      // Get the role doc corresponding to the Auth UID
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
    }

    // Returns the user's single `role` field, or '' if doc missing.
    function singleRole() {
      return userDocExists() ? getUserDoc().get('role', '') : '';
    }

    // Returns the user's `roles` array, or [] if doc missing / field missing.
    function rolesArr() {
      return userDocExists() ? getUserDoc().get('roles', []) : [];
    }

    // Check if user has a given role — look in BOTH the single `role` field
    // (backward compat) AND the `roles` array (new multi-role support).
    function hasRole(r) {
      return singleRole() == r || rolesArr().hasAny([r]);
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('senior_assistant');
    }

    function isAssistant() {
      return hasRole('assistant') || hasRole('receptionist_assistant');
    }

    // --- COLLECTIONS ---

    // 0. User Roles (The Security Map)
    // Users can sync their own role during login, BUT cannot escalate to 'admin'.
    // This prevents the self-escalation attack while allowing normal login flow.
    match /user_roles/{authUid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == authUid || isAdmin());
    }
    
    // 1. Users 
    // Read: Open (needed for UI). Write: Open (relying on UI logic).
    match /users/{userId} {
      allow read: if isAuthenticated(); 
      allow write: if isAuthenticated();
    }

    // 2. Attendance Logs
    // Staff need to write their own attendance? Logic puts it here?
    match /attendance_logs/{logId} {
      allow read, write: if isAuthenticated(); // Keep open for Check-In flow
    }

    // 3. Schedules
    // Admin & Assistant can create schedules
    // All authenticated users can update (needed for "Nhận Lớp" → writes registeredTeachers)
    match /schedules/{dateId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && (isAdmin() || isAssistant());
      allow update: if isAuthenticated();
    }

    // 4. Settings
    // Open (relying on UI logic)
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. Unregistered Alerts (Check-in without class registration)
    // Any authenticated user can create/update (triggered on check-in, set() needs both)
    // Admin can read all and delete
    match /unregistered_alerts/{alertId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // 6. Admin Notifications (Admin → Staff communication)
    // Admin creates notifications when modifying staff data
    // Staff reads their own (filtered by staffId in client query)
    // Note: staffId = Firestore doc ID ≠ Auth UID, so server-side filtering is done in client
    match /admin_notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }
    
    // 7. Receptionist Schedules
    // Open (relying on UI logic)
    match /receptionist_schedules/{weekId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 8. Daily Notes (Firestore-synced, replaces localStorage)
    // All authenticated users can read/write (admin writes notes for specific staff, staff reads own)
    match /daily_notes/{staffId} {
      allow read, write: if isAuthenticated();
    }

    // 9. Salary Settings (Firestore-synced, replaces localStorage)
    // Admin reads/writes salary config per staff. Staff can read their own.
    match /salary_settings/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // 9.1 Monthly Salary Settings (Firestore-synced)
    // Admin reads/writes monthly salary config. Staff can read their own.
    match /salary_settings_monthly/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // 10. Overtime Requests (Staff → Admin for approval)
    // Staff can create/read their own requests (staffId is a stored field, not path param)
    // Admin can read all, update (approve/reject)
    match /overtime_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // 11. Bonus 10p Requests
    match /bonus10_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // 12. Fixed Shifts (Receptionist — feature tương lai)
    match /fixed_shifts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isAssistant());
    }

    // 13. Cancelled Shifts (Admin/Trợ lí tiếp tân hủy ca tiếp tân)
    match /cancelled_shifts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isAssistant());
    }

    // 14. Subjects (Môn Học) — Admin manages, all staff can read
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // Default Block
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
