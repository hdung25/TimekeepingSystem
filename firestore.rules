rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- RBAC HELPERS ---
    function getUserRole() {
      // Get the role doc corresponding to the Auth UID
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    function isAssistant() {
      return getUserRole() == 'assistant';
    }

    // --- COLLECTIONS ---

    // 0. User Roles (The Security Map)
    // Users can sync their own role during login, BUT cannot escalate to 'admin'.
    // This prevents the self-escalation attack while allowing normal login flow.
    match /user_roles/{authUid} {
      allow read: if isAuthenticated() && request.auth.uid == authUid;
      
      // SECURITY FIX v4 (2026-02-16):
      // Users can sync their own role doc during login. Rules:
      // - First-time creation (doc doesn't exist): ALLOWED for all roles
      //   → loginUser() always writes the correct role from 'users' collection
      // - Update existing doc: Can NOT change role to 'admin' unless already admin
      //   → Blocks: Staff DevTools → set({role:'admin'}) on existing doc → DENIED
      allow write: if isAuthenticated() 
        && request.auth.uid == authUid
        && (
          // First-time creation → allow (loginUser writes correct role from DB)
          resource == null
          ||
          // Existing doc: not claiming admin → allow
          request.resource.data.role != 'admin'
          ||
          // Existing doc: claiming admin → only if already admin
          resource.data.role == 'admin'
        );
    }
    
    // 1. Users 
    // Read: Open (needed for UI). Write: Admin Only.
    match /users/{userId} {
      allow read: if isAuthenticated(); 
      allow write: if isAuthenticated() && isAdmin();
    }

    // 2. Attendance Logs
    // Staff need to write their own attendance? Logic puts it here?
    match /attendance_logs/{logId} {
      allow read, write: if isAuthenticated(); // Keep open for Check-In flow
    }

    // 3. Schedules
    // Admin & Assistant can write
    match /schedules/{dateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isAssistant());
    }

    // 4. Settings
    // Admin Only
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // 5. Unregistered Alerts (Check-in without class registration)
    // Any authenticated user can create (triggered on check-in)
    // Admin can read all and update (resolve)
    match /unregistered_alerts/{alertId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isAdmin();
    }
    
    // Default Block
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
